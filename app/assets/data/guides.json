      "id": "guide_batangas_port",
      "placeId": "batangas_port",
      "summary": {
        "en": "A large, busy port with many shipping lines.",
        "fil": "Malaki at mataong pantalan na may maraming shipping line."
      },
      "tips": [
        {
          "en": "Batangas Port is large and busy. Follow the signs to your shipping line's ticket counter.",
          "fil": "Malaki at mataong pantalan ang Batangas Port. Sundan ang mga karatula papunta sa ticket counter ng inyong shipping line."
        },
        {
          "en": "Buses to Manila leave from the bus area outside the passenger terminal.",
          "fil": "Ang mga bus papuntang Maynila ay umaalis sa bus area sa labas ng passenger terminal."
        },
        {
          "en": "Ignore people who offer to buy tickets for you. Use only official counters.",
          "fil": "Huwag pansinin ang mga nag-aalok na sila ang bibili ng tiket para sa inyo. Sa opisyal na counter lang bumili."
        }
      ],
